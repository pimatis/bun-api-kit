# Runtime
NODE_ENV=production
LOG_LEVEL=info

# Limits
MAX_BODY_BYTES=1048576

# CORS origins (comma-separated, production only)
CORS_ALLOWED_ORIGINS=https://api.example.com,https://app.example.com

# Trusted proxies (IPv4 / CIDR, comma-separated)
TRUSTED_PROXY_RANGES=127.0.0.1/32,10.0.0.0/8
TRUSTED_PROXY_IPS=
